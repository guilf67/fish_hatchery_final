<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fish_hatchery_final.faisal.spawingController">

    <Label layoutX="20" layoutY="20" text="Spawning Schedule:" />
    <TableView fx:id="spawningScheduleTV" layoutX="20" layoutY="50" prefHeight="200" prefWidth="380">
        <columns>
            <TableColumn fx:id="dateTC" prefWidth="120" text="Date" />
            <TableColumn fx:id="broodStockTC" prefWidth="259.0" text="Broodstock" />
        </columns>
    </TableView>

    <Label layoutX="450" layoutY="20" text="Tank  Equipment Prep:" />
    <TableView fx:id="PrepTV" layoutX="450" layoutY="50" prefHeight="200" prefWidth="380">
        <columns>
            <TableColumn fx:id="tankTC" prefWidth="180" text="Tank" />
            <TableColumn fx:id="equipmentTC" prefWidth="196.0" text="Equipment" />
        </columns>
    </TableView>

    <Label layoutX="20" layoutY="270" text="Egg Count / Fertilization Data:" />
    <TextField fx:id="eggCountTF" layoutX="20" layoutY="300" prefWidth="200" promptText="Enter egg count" />

    <Button layoutX="240" layoutY="300" onAction="#recordDataOA" prefWidth="150" text="Record Data" />

    <Label layoutX="20" layoutY="350" text="Hatching Observation:" />
    <TextArea fx:id="hatchingNoteTA" layoutX="20" layoutY="380" prefHeight="120" prefWidth="380" promptText="Enter hatching progress note" />

    <Button layoutX="450" layoutY="300" onAction="#saveHatchingOA" prefWidth="250" text="Save Spawning  Hatching Report" />
   <Button layoutX="740.0" layoutY="474.0" onAction="#backOA" prefHeight="25.0" prefWidth="90.0" text="Back" />

</AnchorPane>
