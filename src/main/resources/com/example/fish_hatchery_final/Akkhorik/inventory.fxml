<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fish_hatchery_final.Akkhorik.inventorycontroller">
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10 20;" alignment="CENTER_RIGHT" spacing="10">
            <Label text="Hatchery Inventory Management" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;">
                <graphic>
                    <ImageView>
                        <Image url="@/images/logout.png" />
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Goal 1: Record Feed Stock Entry -->
                <Tab text="Feed Stock">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="15" style="-fx-padding: 20;">
                            <Label text="Record Feed Stock Entry" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1565c0;" />

                            <GridPane hgap="10" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="150"/>
                                    <ColumnConstraints prefWidth="200"/>
                                    <ColumnConstraints prefWidth="150"/>
                                    <ColumnConstraints prefWidth="200"/>
                                </columnConstraints>

                                <Label text="Item Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="feedItemName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Batch Number" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="feedBatchNumber" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                                <Label text="Quantity (kg)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="feedQuantity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Expiry Date" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <DatePicker fx:id="feedExpiryDate" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                                <Label text="Supplier" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="feedSupplier" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Button text="Record Stock Entry" onAction="#handleRecordFeedStock"
                                    style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-weight: bold;"/>

                            <TableView fx:id="feedStockTable" prefHeight="300">
                                <columns>
                                    <TableColumn text="Item" prefWidth="120"/>
                                    <TableColumn text="Batch" prefWidth="100"/>
                                    <TableColumn text="Quantity" prefWidth="80"/>
                                    <TableColumn text="Expiry" prefWidth="100"/>
                                    <TableColumn text="Supplier" prefWidth="120"/>
                                    <TableColumn text="Date Added" prefWidth="100"/>
                                </columns>
                            </TableView>

                            <BarChart prefHeight="250" prefWidth="800" title="Current Feed Stock Levels">
                                <xAxis>
                                    <CategoryAxis label="Feed Type" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Quantity (kg)" />
                                </yAxis>
                            </BarChart>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- Goal 2: Track Material Usage -->
                <Tab text="Material Usage">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="15" style="-fx-padding: 20;">
                            <Label text="Track Usage of Hatchery Materials" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1565c0;" />

                            <GridPane hgap="10" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="150"/>
                                    <ColumnConstraints prefWidth="200"/>
                                    <ColumnConstraints prefWidth="150"/>
                                    <ColumnConstraints prefWidth="200"/>
                                </columnConstraints>

                                <Label text="Material Type" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="materialType" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Item Name" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="materialItem" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                                <Label text="Used Quantity" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="usedQuantity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Used By" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <TextField fx:id="usedBy" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                                <Label text="Usage Date" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <DatePicker fx:id="usageDate" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Button text="Record Material Usage" onAction="#handleRecordMaterialUsage"
                                    style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-weight: bold;"/>

                            <TableView fx:id="materialsTable" prefHeight="300">
                                <columns>
                                    <TableColumn text="Type" prefWidth="100"/>
                                    <TableColumn text="Item" prefWidth="120"/>
                                    <TableColumn text="Quantity" prefWidth="80"/>
                                    <TableColumn text="Used By" prefWidth="100"/>
                                    <TableColumn text="Date" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- Goal 3: Generate Monthly Reports -->
                <Tab text="Monthly Reports">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="15" style="-fx-padding: 20;">
                            <Label text="Generate Monthly Inventory Report" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1565c0;" />

                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Report Month"/>
                                    <DatePicker fx:id="inventoryReportMonth" prefWidth="150"/>
                                </VBox>
                                <Button text="Generate Report" onAction="#handleGenerateInventoryReport"
                                        style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </HBox>

                            <TextArea fx:id="inventoryReport" prefRowCount="10" promptText="Monthly inventory report will appear here..."/>

                            <TableView fx:id="reportTable" prefHeight="300">
                                <columns>
                                    <TableColumn text="Item" prefWidth="120"/>
                                    <TableColumn text="Category" prefWidth="100"/>
                                    <TableColumn text="Start Stock" prefWidth="80"/>
                                    <TableColumn text="End Stock" prefWidth="80"/>
                                    <TableColumn text="Usage" prefWidth="80"/>
                                    <TableColumn text="Status" prefWidth="80"/>
                                </columns>
                            </TableView>

                            <BarChart prefHeight="300" prefWidth="800" title="Monthly Inventory Usage">
                                <xAxis>
                                    <CategoryAxis label="Item Category" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Quantity Used" />
                                </yAxis>
                            </BarChart>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- Goal 4: Monitor Stock Levels -->
                <Tab text="Stock Monitoring">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="15" style="-fx-padding: 20;">
                            <Label text="Monitor Stock Levels and Reorder Materials" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1565c0;" />

                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Item to Check"/>
                                    <TextField fx:id="itemToCheck" prefWidth="200"/>
                                </VBox>
                                <Button text="Check Stock" onAction="#handleCheckStockLevel"
                                        style="-fx-background-color: #1976d2; -fx-text-fill: white;"/>
                            </HBox>

                            <HBox spacing="20">
                                <Label fx:id="currentStockLabel" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                                <Label fx:id="reorderStatus" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                            </HBox>

                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Reorder Amount"/>
                                    <TextField fx:id="reorderAmount" prefWidth="150"/>
                                </VBox>
                                <Button text="Initiate Reorder" onAction="#handleInitiateReorder"
                                        style="-fx-background-color: #ff9800; -fx-text-fill: white;"/>
                            </HBox>

                            <TableView fx:id="stockLevelsTable" prefHeight="300">
                                <columns>
                                    <TableColumn text="Item" prefWidth="120"/>
                                    <TableColumn text="Current Stock" prefWidth="100"/>
                                    <TableColumn text="Min Threshold" prefWidth="100"/>
                                    <TableColumn text="Status" prefWidth="80"/>
                                    <TableColumn text="Last Checked" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- Additional tabs for Goals 5-8 would follow the same pattern -->
                <Tab text="Supply Requests">
                    <!-- Content for Goal 5 -->
                </Tab>

                <Tab text="Logistics">
                    <!-- Content for Goal 6 -->
                </Tab>

                <Tab text="Vendor Payments">
                    <!-- Content for Goal 7 -->
                </Tab>

                <Tab text="Asset Maintenance">
                    <!-- Content for Goal 8 -->
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>