<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fish_hatchery_final.anika.feedmonitorController">
    <children>
        <Label layoutX="231.0" layoutY="14.0" prefHeight="17.0" prefWidth="80.0" text="Feed Monitor" />
        <Label layoutX="53.0" layoutY="55.0" text="Pond:" />
        <Label layoutX="198.0" layoutY="55.0" text="Start Date:" />
        <Label layoutX="365.0" layoutY="55.0" text="End Date:" />
        <Label layoutX="33.0" layoutY="134.0" text="Actual Feed(kg):" />
        <Label layoutX="224.0" layoutY="134.0" text="Corrective Action:" />
        <Label layoutX="33.0" layoutY="95.0" text="Record Actual Feed" />
        <TextField fx:id="actualFeedTF" layoutX="123.0" layoutY="130.0" prefHeight="25.0" prefWidth="94.0" />
        <TextField fx:id="correctiveActionTF" layoutX="329.0" layoutY="130.0" prefHeight="25.0" prefWidth="94.0" />
        <DatePicker fx:id="endDateDP" layoutX="423.0" layoutY="51.0" prefHeight="25.0" prefWidth="123.0" />
        <DatePicker fx:id="startDateDP" layoutX="260.0" layoutY="51.0" prefHeight="25.0" prefWidth="103.0" />
        <ComboBox fx:id="pondCB" layoutX="89.0" layoutY="51.0" prefHeight="25.0" prefWidth="94.0" />
        <Button layoutX="468.0" layoutY="91.0" mnemonicParsing="false" onAction="#loadDataOA" text="Load Data " />
        <Button layoutX="532.0" layoutY="19.0" mnemonicParsing="false" onAction="#backOA" text="Back" />
        <Button layoutX="468.0" layoutY="130.0" mnemonicParsing="false" onAction="#updateRecordOA" text="Update Record" />
        <Label layoutX="48.0" layoutY="175.0" text="Planned vs Actual Feed Summary" />
        <TableView fx:id="plannedVsActualTV" layoutX="9.0" layoutY="200.0" prefHeight="152.0" prefWidth="581.0">
            <columns>
                <TableColumn fx:id="plannedFeedTC" prefWidth="118.0" text="Planned Feed (kg)" />
                <TableColumn fx:id="actualFeedCol" prefWidth="104.0" text="Actual Feed (kg)" />
                <TableColumn fx:id="deviationCol" prefWidth="95.0" text="Deviation%" />
                <TableColumn fx:id="alertCol" prefWidth="51.0" text="Alert" />
                <TableColumn fx:id="correctiveActionCol" prefWidth="120.0" text="Corrective Action" />
                <TableColumn fx:id="dateCol" prefWidth="95.0" text="Date" />
            </columns>
        </TableView>
        <Button layoutX="27.0" layoutY="361.0" mnemonicParsing="false" onAction="#saveMonthlyReportOA" text="Save Monthly Report" />
    </children>
</AnchorPane>
