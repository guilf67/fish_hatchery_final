        <Button layoutX="211.0" layoutY="361.0" mnemonicParsing="false" onAction="#exportCsvOA" text="Export As CSV" />
        <Button layoutX="342.0" layoutY="361.0" mnemonicParsing="false" onAction="#mailRecordManagerOA" text="Mail Record To Manager" />
