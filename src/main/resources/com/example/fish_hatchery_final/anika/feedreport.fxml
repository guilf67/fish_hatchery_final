        <Label layoutX="200.0" layoutY="93.0" prefHeight="17.0" prefWidth="36.0" text="Pond" />
        <TextField fx:id="monthTF" layoutX="81.0" layoutY="89.0" prefHeight="25.0" prefWidth="102.0" />
        <ComboBox fx:id="pondCB" layoutX="236.0" layoutY="89.0" prefWidth="150.0" />
        <Button layoutX="489.0" layoutY="31.0" mnemonicParsing="false" onAction="#backOA" text="Back" />
